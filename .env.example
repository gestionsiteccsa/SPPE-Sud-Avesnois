# Environnement : development, staging ou production
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=remplacer-par-une-cle-aleatoire-differente-par-environnement
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# SQLite : ces chemins locaux sont copiables ; utiliser des chemins absolus privés en production
DATABASE_PATH=db.sqlite3
SQLITE_TIMEOUT=20

# Répertoire privé des sauvegardes SQLite (obligatoire et hors STATIC_ROOT en production)
BACKUP_DIR=backups
# Nombre de sauvegardes conservées par la rotation automatique
BACKUP_RETENTION=7

# Répertoire alimenté par collectstatic
STATIC_ROOT=staticfiles

# Production : URL TCP ou socket Unix fournie par Redis o2switch
REDIS_URL=
RATELIMIT_ENABLE=True

# SMTP o2switch ; ne jamais versionner le vrai mot de passe
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@example.test
SERVER_EMAIL=noreply@example.test

# URL publique du site (utilisée dans les emails envoyés)
SITE_URL=https://bddpe.fr

# Durcir progressivement après validation HTTPS complète
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
LOG_LEVEL=INFO

# Chemin de l'admin Django ; personnaliser en production (jamais /admin/ par défaut)
ADMIN_URL=gestion-interne/

# Content Security Policy applicative par nonce (l'admin en est exclu)
CSP_ENABLED=True
